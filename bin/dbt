#!/usr/bin/env bash
# Run dbt with .env loaded and the repo's profiles.yml.   bin/dbt build
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$root/.env" ]; then set -a; source "$root/.env"; set +a; fi
export PYTHONWARNINGS=ignore
cd "$root/dbt"
exec uv run --project "$root" dbt "$@" --profiles-dir "$root/dbt"
