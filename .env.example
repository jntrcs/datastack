# Copy to .env and fill in.

# App Store Connect (Sales-role key, same one the PersonalSite Worker uses)
ASC_KEY_ID=<your-key-id>
ASC_ISSUER_ID=<your-issuer-id>
ASC_VENDOR_NUMBER=<your-vendor-number>
ASC_PRIVATE_KEY_PATH=~/.appstoreconnect/AuthKey_<your-key-id>.p8

# Where raw files land: a local folder, or r2://<bucket>
LANDING=./data
# LANDING=r2://datastack-raw

# R2 (only needed when LANDING=r2://...)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare Web Analytics (GraphQL). Token needs Account > Account Analytics > Read.
CF_ACCOUNT_ID=<your-cloudflare-account-id>
CF_API_TOKEN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/datastack_rsa_key.p8
