{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "select max(cumulative_actual) as downloads_to_date,\n",
        "  date_format(any_value(milestone_date_p50), 'MMM d, yyyy') as milestone_p50,\n",
        "  concat(date_format(any_value(milestone_date_p10), 'MMM d'), ' \u2013 ', date_format(any_value(milestone_date_p90), 'MMM d')) as milestone_range,\n",
        "  round(any_value(holdout_mae), 1) as mae, round(any_value(holdout_mae_naive), 1) as mae_naive,\n",
        "  round(100 * (1 - any_value(holdout_mae) / any_value(holdout_mae_naive))) as skill_pct,\n",
        "  round(100 * any_value(holdout_interval_coverage)) as coverage_pct,\n",
        "  date_format(any_value(generated_at), 'yyyy-MM-dd HH:mm') as generated_at\n",
        "from workspace.forecasting.download_forecast"
      ]
    },
    {
      "name": "daily",
      "displayName": "Daily downloads: actual vs forecast",
      "queryLines": [
        "select date, series, value from workspace.forecasting.download_forecast\n",
        "unpivot (value for series in (actual as `Actual`, yhat as `Forecast`, yhat_lower as `Forecast 80% low`, yhat_upper as `Forecast 80% high`))\n",
        "where value is not null"
      ]
    },
    {
      "name": "cumulative",
      "displayName": "Cumulative downloads trajectory",
      "queryLines": [
        "select date, series, value from (select date, cumulative_actual, cumulative_yhat, cumulative_lower, cumulative_upper, cast(milestone as double) as goal from workspace.forecasting.download_forecast)\n",
        "unpivot (value for series in (cumulative_actual as `Actual`, cumulative_yhat as `Forecast (median)`, cumulative_lower as `Forecast 80% low`, cumulative_upper as `Forecast 80% high`, goal as `Goal: 1,000`))\n",
        "where value is not null"
      ]
    }
  ],
  "pages": [
    {
      "name": "forecast",
      "displayName": "Forecast",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Chronic Health \u2014 first-time download forecast\n",
                "Prophet on sqrt(daily downloads), weekly seasonality, refit nightly 15:00 UTC on the dbt mart `ANALYTICS.MARTS.DAILY_KPIS` in Snowflake (read in place via Lakehouse Federation). Bands are 80% intervals from 1,000 simulated futures. Run history in MLflow."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "c_total",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpis",
                  "fields": [
                    {
                      "name": "downloads_to_date",
                      "expression": "`downloads_to_date`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "downloads_to_date",
                  "displayName": "Downloads to date"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Downloads to date"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 1,
            "height": 3
          }
        },
